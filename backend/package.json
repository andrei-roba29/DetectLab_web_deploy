    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "pg-copy-streams": "^6.0.6",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0"
  },
  "devDependencies": {
    "pino-pretty": "^11.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
