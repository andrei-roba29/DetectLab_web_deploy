{
  "name": "detectlab-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "DetectLab API + nightly ArcGIS -> PostGIS sync pipeline",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
