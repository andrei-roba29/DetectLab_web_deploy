# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Postgres / PostGIS ---
DATABASE_URL=postgresql://detectlab:detectlab@localhost:5432/detectlab
# Set to true for hosted providers that require SSL (Supabase, Railway, etc).
# Leave false for a local Postgres install.
PGSSL=false

# --- JWT ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Supabase (used to verify user tokens for the payments API) ---
# URL + anon key from your Supabase project (Settings → API). The anon
# key is public (it's already in js/supabase.js).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Persistent archaeological evidence ingestion ---
# Long random value required by ingestion/review administration endpoints.
INGESTION_ADMIN_KEY=change_me_to_a_long_random_ingestion_key
# Enable only on one backend instance to avoid unnecessary source traffic.
EVIDENCE_WORKER_ENABLED=false
# Conservative process-wide interval between biblioteca-digitala.ro requests.
BIBLIOTECA_REQUEST_INTERVAL_MS=1200
# One retry delay for a refused/rate-limited source response (HTTP 403/429/5xx).
# Shared hosting egress IPs hit the source's bot filter intermittently, so a
# short second attempt normally clears it.
BIBLIOTECA_RETRY_BACKOFF_MS=1500
# Wall-clock budget for the live crawl an interactive search triggers. The
# source is politely throttled, so an unbounded run can outlast the platform's
# HTTP timeout: the engine then answers with everything it already read,
# flagged `truncated`, and the locality is re-checked the same day.
EVIDENCE_RESEARCH_BUDGET_MS=45000
# Echo the underlying error text in failed evidence responses (staging only —
# production returns a coded error plus a request id that ties to the logs).
EVIDENCE_DEBUG=false
# --- SIRUTA import (npm run import:siruta) ---
# Official INS data.gov.ro source — always recorded as source_url in PostgreSQL.
# The importer fetches from SIRUTA_SOURCE_URL (defaults to the official URL).
SIRUTA_SOURCE_URL=https://data.gov.ro/dataset/fcba1a54-cffd-422c-b3ac-920f63564085/resource/0ab29d86-302c-4cfa-b9b9-fd5c7ff90710/download/siruta_s1_2025.csv
# SIRUTA_URL is a backwards-compatible alias for SIRUTA_SOURCE_URL.
# SIRUTA_SOURCE_URL takes precedence if both are set.
SIRUTA_URL=
SIRUTA_VERSION=S1 2025
# Supply a pre-downloaded SIRUTA CSV file path on the server.
# Resolution order: CLI argument > SIRUTA_CSV_PATH > SIRUTA_SOURCE_URL.
# The official data.gov.ro URL is still recorded as source_url regardless.
SIRUTA_CSV_PATH=
# Fetch timeout in milliseconds (default 30000).
SIRUTA_FETCH_TIMEOUT_MS=30000
# Number of retries for the fetch (default 3).
SIRUTA_FETCH_RETRIES=3

# --- Stripe (real payments — leave empty until you're ready to go live) ---
# Get keys at https://dashboard.stripe.com/apikeys (test/live).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Created by: STRIPE_SECRET_KEY=sk_test_xxx node scripts/setupStripe.js
#
# ONE-TIME €5 price — Premium for one calendar month, NO automatic
# renewal. This is what all new checkouts use (Checkout mode "payment").
STRIPE_ONE_TIME_PRICE_ID=price_xxx
# Legacy recurring €5/month price. Kept only for backwards compatibility:
# existing subscribers keep renewing, and it is used as a fallback when
# STRIPE_ONE_TIME_PRICE_ID is not set. Do not set it for new deployments.
STRIPE_PRICE_ID=price_xxx
# Public frontend origin used for Stripe's success/cancel redirects.
# Falls back to the request's Origin header if empty (fine for local dev).
STRIPE_SITE_URL=https://your-frontend.example

# --- ArcGIS source ---
ARCGIS_BASE_URL=https://eism.geo-spatial.ro/eismgeo/rest/services/Patrimoniu/PatrimoniuWM/MapServer
ARCGIS_PAGE_SIZE=1000
ARCGIS_CONCURRENCY=2
ARCGIS_REQUEST_TIMEOUT_MS=15000
ARCGIS_MAX_RETRIES=3

# Abort the whole sync (and keep serving old data) if we fetch fewer than
# this fraction of the expected feature count, even after retries.
SYNC_MIN_SUCCESS_RATIO=0.98

# --- Scheduling ---
SYNC_CRON="0 0 * * *"
SYNC_ON_BOOT=false
